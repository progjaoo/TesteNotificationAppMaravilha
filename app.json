{
  "expo": {
    "name": "Rádio Maravilha FM",
    "slug": "maravilhafmbh",
    "version": "7.0.0",
    "orientation": "portrait",
    "icon": "./assets/logomaravilha.png",
    "scheme": "maravilhaapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logomaravilha.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF8000"
    },
    "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.claitonbarbosa.89maravilhafm",
    "infoPlist": {
      "UIBackgroundModes": [
        "audio"
      ],
      "AVAudioSessionCategory": "playback",
      "AVAudioSessionCategoryOptions": [
        "mixWithOthers",
        "duckOthers",
        "allowBluetooth",
        "allowBluetoothA2DP"
      ],
      "ITSAppUsesNonExemptEncryption": false
    }
  },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.claitonbarbosa.maravilhafmbh"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "72620fb9-520c-4d72-985b-d32125b8eade"
      }
    }
  }
}