{
  "expo": {
    "name": "MaravilhaApp",
    "slug": "MaravilhaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logomaravilha.png",
    "scheme": "maravilhaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#FF8C19"
        },
        "ios": {
          "supportsTablet": true
        },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF8000",
        "foregroundImage": "./assets/logomaravilha.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
