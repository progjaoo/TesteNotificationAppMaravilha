{
  "expo": {
    "name": "Rádio Maravilha FM",
    "slug": "maravilhafmbh",
    "version": "7.0.2",
    "orientation": "portrait",
    "icon": "./assets/logomaravilha.png",
    "scheme": "maravilhaapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logomaravilha.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF8000"
    },
    "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.claitonbarbosa.89maravilhafm",
    "googleServicesFile": "./GoogleService-Info.plist",
    "infoPlist": {
      "UIBackgroundModes": [
        "audio"
      ],
      "AVAudioSessionCategory": "playback",
      "AVAudioSessionCategoryOptions": [
        "mixWithOthers",
        "duckOthers",
        "allowBluetooth",
        "allowBluetoothA2DP"
      ],
      "ITSAppUsesNonExemptEncryption": false
    }
  },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.claitonbarbosa.maravilhafmbh",
      "googleServicesFile": "./google-services.json",
      "permissions": [
          "FOREGROUND_SERVICE",
          "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
          "WAKE_LOCK",
          "INTERNET",
          "BLUETOOTH_CONNECT",
          "BLUETOOTH",
          "ACCESS_NETWORK_STATE",
          "SCHEDULE_EXACT_ALARM",
          "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "72620fb9-520c-4d72-985b-d32125b8eade"
      }
    }
  }
}